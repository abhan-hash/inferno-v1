<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="arm_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <joint name="yaw">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['yaw']}</param>
                </state_interface>
                
            </joint>
            <joint name="pitch1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['pitch1']}</param>
                </state_interface>
                
            </joint>
            <joint name="pitch2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['pitch2']}</param>
                </state_interface>
                
            </joint>
            <joint name="pitch3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['pitch3']}</param>
                </state_interface>
                
            </joint>
            <joint name="gripper">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['gripper']}</param>
                </state_interface>
                
            </joint>
            <joint name="pitch4">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['pitch4']}</param>
                </state_interface>
                
            </joint>

            <joint name="roll">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['roll']}</param>
                </state_interface>
                
            </joint> 
        </ros2_control>
    </xacro:macro>
</robot>
