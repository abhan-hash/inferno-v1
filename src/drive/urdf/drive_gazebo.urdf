<?xml version="1.0" encoding="utf-8"?>
<!--
  drive_gazebo.urdf — CORRECT version

  What was wrong in previous attempts:
  1. We replaced the original wheel joint rpy + axis values, breaking orientation.
     The SolidWorks-exported rpy/axis on wheel joints were CORRECT and must be kept.
  2. Wheel mass was 32.802 kg (SolidWorks assembly mass) → fixed to 0.5 kg each.
  3. Cylinder collision was misoriented. With original rpy, the spin axis in
     wheel link local frame ≈ Z, so cylinder needs rpy="0 0 0" (long axis = Z = spin axis).
  4. Spawn height was 0.3 m. Kinematic chain puts wheel centers at Z=+0.68 relative
     to base_link, so base_link must spawn at Z = -(0.68 - 0.06) = -0.62 m.
-->
<robot name="drive">

  <link name="base_link"/>

  <link name="base">
    <inertial>
      <origin xyz="-0.345788930637997 -0.153460943930369 -0.0148574304076997" rpy="0 0 0"/>
      <mass value="34.1059688345868"/>
      <inertia ixx="2.15746797612818" ixy="0.00470920534979304" ixz="-1.71459033522724E-06"
               iyy="0.759382756881473" iyz="0.00265969830513678" izz="2.53264735973746"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/base.STL"/></geometry>
      <material name=""><color rgba="0.752941 0.752941 0.752941 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/base.STL"/></geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 1" rpy="0 3.1416 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>

  <!-- ===================== RIGHT SIDE ===================== -->

  <link name="right_front">
    <inertial>
      <origin xyz="-0.12375 -0.053132 0.0225" rpy="0 0 0"/>
      <mass value="0.26897"/>
      <inertia ixx="0.001013" ixy="-0.0017699" ixz="2.1696E-09"
               iyy="0.0042352" iyz="1.083E-09" izz="0.0051616"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/right_front.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/right_front.STL"/></geometry>
    </collision>
  </link>

  <joint name="joint_right_front" type="fixed">
    <origin xyz="-0.070337 -0.15542 -0.062427" rpy="-1.5708 0.12123 1.5708"/>
    <parent link="base"/>
    <child link="right_front"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
  </joint>

  <link name="right_bogie">
    <inertial>
      <origin xyz="-4.0066E-06 -0.13053 0.016329" rpy="0 0 0"/>
      <mass value="0.59393"/>
      <inertia ixx="0.0020082" ixy="2.9932E-07" ixz="-1.3098E-08"
               iyy="0.0053136" iyz="3.3927E-09" izz="0.0045241"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/right_bogie.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/right_bogie.STL"/></geometry>
    </collision>
  </link>

  <joint name="joint_right_bogie" type="fixed">
    <origin xyz="-0.31109 -0.16078 0" rpy="-3.1416 0 3.0204"/>
    <parent link="right_front"/>
    <child link="right_bogie"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
  </joint>

  <link name="wheel_1">
    <inertial>
      <origin xyz="-0.08218 0.0011573 0.007099" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.60349" ixy="-0.0034113" ixz="-0.020925" iyy="0.36113" iyz="0.00029621" izz="0.3629" />
    </inertial>
    <visual>
      <geometry> <mesh filename="package://drive/meshes/wheel_1.STL" /> </geometry>
      <material name=""> <color rgba="0.79216 0.81961 0.93333 1" /> </material>
    </visual>
    <collision>
      <geometry> <mesh filename="package://drive/meshes/wheel_1.STL" /> </geometry>
      <surface>
        <friction>
          <ode><mu>1.0</mu><mu2>0.2</mu2></ode>
        </friction>
      </surface>
    </collision>
  </link>

  <joint name="joint_wheel_1" type="continuous">
    <!-- ORIGINAL rpy and axis from SolidWorks — DO NOT CHANGE -->
    <origin xyz="0.225 -0.18509 0" rpy="0.16161 1.4835 0.35684"/>
    <parent link="right_bogie"/>
    <child link="wheel_1"/>
    <axis xyz="-0.99619 0.014024 0.08602"/>
    <limit lower="-1000000" upper="1000000" effort="1000" velocity="1000"/>
  </joint>

  <!-- WHEEL 2 — right bogie rear -->
  <link name="wheel_2">
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.603" ixy="0" ixz="0" iyy="0.361" iyz="0" izz="0.362" />
    </inertial>
    <visual> 
        <geometry> <mesh filename="package://drive/meshes/wheel_2.STL" /> </geometry> 
        <material name=""> <color rgba="0.79216 0.81961 0.93333 1" /> </material>
    </visual>
    <collision>
      <geometry> <mesh filename="package://drive/meshes/wheel_2.STL" /> </geometry>
      <surface>
        <friction>
          <ode><mu>1.0</mu><mu2>0.2</mu2></ode>
        </friction>
      </surface>
    </collision>
  </link>

  <joint name="joint_wheel_2" type="continuous">
    <origin xyz="-0.225 -0.18509 0" rpy="0.16161 1.4835 0.42392"/>
    <parent link="right_bogie"/>
    <child link="wheel_2"/>
    <axis xyz="-0.99619 0.014024 0.08602"/>
  </joint>

  <!-- RIGHT BACK -->
  <link name="right_back">
    <inertial>
      <origin xyz="0.30742 -0.20016 0.070431" rpy="0 0 0"/>
      <mass value="0.46295"/>
      <inertia ixx="0.0037369" ixy="0.0028292" ixz="2.8411E-09"
               iyy="0.0040089" iyz="-4.7273E-09" izz="0.0063232"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/right_back.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/right_back.STL"/></geometry>
    </collision>
  </link>

  <joint name="joint_right_back" type="fixed">
    <origin xyz="0 -0.10542 -0.012427" rpy="-1.5708 0.12123 1.5708"/>
    <parent link="base"/>
    <child link="right_back"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
  </joint>

  <!-- WHEEL 3 — right back -->
  <link name="wheel_3">
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.603" ixy="0" ixz="0" iyy="0.361" iyz="0" izz="0.362" />
    </inertial>
    <visual> 
        <geometry> <mesh filename="package://drive/meshes/wheel_3.STL" /> </geometry> 
        <material name=""> <color rgba="0.79216 0.81961 0.93333 1" /> </material>
    </visual>
    <collision>
      <geometry> <mesh filename="package://drive/meshes/wheel_3.STL" /> </geometry>
      <surface>
        <friction>
          <ode> <mu>1.0</mu> <mu2>0.2</mu2> </ode>
        </friction>
      </surface>
    </collision>
  </link>

  <joint name="joint_wheel_3" type="continuous">
    <origin xyz="0.45337 -0.39 0" rpy="-2.98 -1.4835 2.1495"/>
    <parent link="right_back"/>
    <child link="wheel_3"/>
    <axis xyz="-0.99619 0.014024 0.08602"/>
  </joint>

  <!-- ===================== LEFT SIDE ===================== -->

  <link name="left_front">
    <inertial>
      <origin xyz="-0.12375 -0.053132 0.0225" rpy="0 0 0"/>
      <mass value="0.26897"/>
      <inertia ixx="0.001013" ixy="-0.0017699" ixz="2.1696E-09"
               iyy="0.0042352" iyz="1.083E-09" izz="0.0051616"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/left_front.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/left_front.STL"/></geometry>
    </collision>
  </link>

  <joint name="joint_left_front" type="fixed">
    <origin xyz="-0.56534 -0.15578 -0.062427" rpy="-1.5708 0.12123 1.5708"/>
    <parent link="base"/>
    <child link="left_front"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
  </joint>

  <link name="left_bogie">
    <inertial>
      <origin xyz="-4.009E-06 -0.13053 0.061329" rpy="0 0 0"/>
      <mass value="0.59393"/>
      <inertia ixx="0.0020082" ixy="2.9938E-07" ixz="-1.3098E-08"
               iyy="0.0053136" iyz="3.3927E-09" izz="0.0045241"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/left_bogie.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/left_bogie.STL"/></geometry>
    </collision>
  </link>

  <joint name="joint_left_bogie" type="fixed">
    <origin xyz="-0.31109 -0.16078 0" rpy="0 0 -0.12123"/>
    <parent link="left_front"/>
    <child link="left_bogie"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
  </joint>

  <!-- WHEEL 4 — left bogie rear -->
  <link name="wheel_4">
     <inertial> <mass value="0.5" /> <inertia ixx="0.603" ixy="0" ixz="0" iyy="0.361" iyz="0" izz="0.362" /> </inertial>
     <visual> 
        <geometry> <mesh filename="package://drive/meshes/wheel_4.STL" /> </geometry> 
        <material name=""> <color rgba="0.79216 0.81961 0.93333 1" /> </material>
    </visual>
     <collision>
       <geometry> <mesh filename="package://drive/meshes/wheel_4.STL" /> </geometry>
       <surface>
        <friction>
          <ode> <mu>1.0</mu> <mu2>0.2</mu2> </ode>
        </friction>
      </surface>
     </collision>
  </link>

  <joint name="joint_wheel_4" type="continuous">
    <origin xyz="-0.225 -0.18509 0.016876" rpy="0.16161 1.4835 -0.33202"/>
    <parent link="left_bogie"/>
    <child link="wheel_4"/>
    <axis xyz="-0.99619 0.014024 0.08602"/>
  </joint>

  <!-- WHEEL 5 — left bogie forward -->
  <link name="wheel_5">
     <inertial> <mass value="0.5" /> <inertia ixx="0.603" ixy="0" ixz="0" iyy="0.361" iyz="0" izz="0.362" /> </inertial>
     <visual> 
        <geometry> <mesh filename="package://drive/meshes/wheel_5.STL" /> </geometry> 
        <material name=""> <color rgba="0.79216 0.81961 0.93333 1" /> </material>
    </visual>
     <collision>
       <geometry> <mesh filename="package://drive/meshes/wheel_5.STL" /> </geometry>
       <surface>
        <friction>
          <ode> <mu>1.0</mu> <mu2>0.2</mu2> </ode>
        </friction>
      </surface>
     </collision>
  </link>

  <joint name="joint_wheel_5" type="continuous">
    <origin xyz="0.225 -0.18509 0.016876" rpy="0.16161 1.4835 -1.252"/>
    <parent link="left_bogie"/>
    <child link="wheel_5"/>
    <axis xyz="-0.99619 0.014024 0.08602"/>
  </joint>

  <!-- LEFT BACK -->
  <link name="left_back">
    <inertial>
      <origin xyz="0.307417610449746 -0.200159784838589 0.0649065740190656" rpy="0 0 0"/>
      <mass value="0.462954112817127"/>
      <inertia ixx="0.00373689017269687" ixy="0.00282920501842546" ixz="2.84105774800552E-09"
               iyy="0.00400887791416429" iyz="-4.72732351366836E-09" izz="0.00632322267910215"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/left_back.STL"/></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://drive/meshes/left_back.STL"/></geometry>
    </collision>
  </link>

  <joint name="joint_left_back" type="fixed">
    <origin xyz="-0.54534 -0.10578 -0.012427" rpy="-1.5708 0.12123 1.5708"/>
    <parent link="base"/>
    <child link="left_back"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0" effort="0" velocity="0"/>
  </joint>

  <!-- WHEEL 6 — left back -->
  <link name="wheel_6">
     <inertial> <mass value="0.5" /> <inertia ixx="0.603" ixy="0" ixz="0" iyy="0.361" iyz="0" izz="0.362" /> </inertial>
     <visual> 
        <geometry> <mesh filename="package://drive/meshes/wheel_6.STL" /> </geometry> 
        <material name=""> <color rgba="0.79216 0.81961 0.93333 1" /> </material>
    </visual>
     <collision>
       <geometry> <mesh filename="package://drive/meshes/wheel_6.STL" /> </geometry>
       <surface>
        <friction>
          <ode> <mu>1.0</mu> <mu2>0.2</mu2> </ode>
        </friction>
      </surface>
     </collision>
  </link>

  <joint name="joint_wheel_6" type="continuous">
    <origin xyz="0.45337 -0.39 0.034376" rpy="0.16161 1.4835 -0.74019"/>
    <parent link="left_back"/>
    <child link="wheel_6"/>
    <axis xyz="-0.99619 0.014024 0.08602"/>
  </joint>

<!-- ____________________LIDAR________________________ -->

  <link name="lidar_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.25 -0.38 0.80" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <always_on>1</always_on>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <ignition_frame_id>lidar_link</ignition_frame_id>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo> 

  <!-- _________________________IMU__________________________ -->

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <geometry><box size="0.03 0.03 0.01"/></geometry>
      <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.30 -0.40 0.52" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>imu</topic>
        <ignition_frame_id>imu_link</ignition_frame_id>
     </sensor>
  </gazebo>


  <gazebo>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
    </plugin>
  </gazebo>
  

  <!-- ==================== ROS2_CONTROL ==================== -->
  <!--
    This replaces the old ignition::gazebo::systems::DiffDrive plugin.
    We use ign_ros2_control (the bridge between Ignition Gazebo and ros2_control).
    The hardware interface handles all 6 wheel joints.
  -->
  <ros2_control name="IgnitionSystem" type="system">
    <hardware>
      <!-- <plugin>ign_ros2_control/IgnitionSystem</plugin> -->
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>

    <!-- RIGHT WHEELS (treated as right side of differential drive) -->
    <joint name="joint_wheel_1">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_wheel_2">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_wheel_3">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- LEFT WHEELS (treated as left side of differential drive) -->
    <joint name="joint_wheel_4">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_wheel_5">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_wheel_6">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

<!--____________________________ Gazebo Plugins ______________________________ -->

 <!-- ign_ros2_control plugin — loads the ros2_control hardware interface into Ignition -->
  <!-- <gazebo>
    <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control">

      <parameters>/home/jotaro/ros2_ws/install/drive/share/drive/config/controllers.yaml</parameters>
    </plugin>
  </gazebo> -->

  <gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>/home/jotaro/ros2_ws/install/drive/share/drive/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Optional: keep gazebo friction/surface properties for wheels -->
  <gazebo reference="wheel_1"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="wheel_2"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="wheel_3"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="wheel_4"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="wheel_5"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="wheel_6"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>

<!--_________________________________________________________ -->
</robot>
